# Files/dirs to exclude from Vercel deployment
# These are not needed in production and would bloat the deployment

# Old backup of static site
vercel-deploy-old-backup/

# Old git repo (was for the static site)
git-repo/

# Upload folder (source PDFs - not needed in production)
upload/

# Skills (Z.ai internal)
skills/

# Scripts (dev/seed scripts - not needed at runtime)
scripts/

# Download folder (delivery artifacts)
download/

# Local SQLite db (we use Neon Postgres)
db/

# Local env files (env vars set via Vercel dashboard)
.env
.env.local
.env.development
.env.production

# Logs
*.log
dev.log
server.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Misc
README.md
worklog.md
agent-ctx/
mini-services/
examples/

# Backups and intermediate files (not needed in production)
data/backups/
data/kent-remedies-fresh.json
data/kent-remedies-final.json
work/
backups/
