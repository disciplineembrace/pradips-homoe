// Prisma schema for Pradip's Homoe — PIN-only auth system
// No passwords. Login is purely via unique 6-digit PIN.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  pinHash    String
  role       String   @default("user")
  status     String   @default("active")
  pinFailCount   Int      @default(0)
  pinLockedUntil DateTime?
  lastLoginAt    DateTime?
  lastPinAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loginLogs LoginLog[]
  pinLogs   PinLog[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  event     String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model PinLog {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  event     String
  failCount Int?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
