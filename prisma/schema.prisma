// Prisma schema for Pradip's Homoe — PIN-only auth + One-Device-Per-User + Admin Biometric

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  pinHash    String
  role       String   @default("user")
  status     String   @default("active")
  pinFailCount   Int      @default(0)
  pinLockedUntil DateTime?
  lastLoginAt    DateTime?
  lastPinAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loginLogs     LoginLog[]
  pinLogs       PinLog[]
  auditLogs     AuditLog[]
  deviceSessions DeviceSession[]
  webauthnCreds  WebAuthnCredential[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model DeviceSession {
  id              String   @id @default(cuid())
  userId          String
  deviceId        String   @unique  // unique per device session
  deviceInfo      String?  // browser/OS info
  ip              String?
  loginAt         DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  isActive        Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
}

model WebAuthnCredential {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique  // base64url encoded
  publicKey       String             // base64url encoded COSE key
  counter         Int      @default(0)
  deviceType      String?  // platform/cross-platform
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  event     String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model PinLog {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  event     String
  failCount Int?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
