// Prisma schema for Pradip's Homoe — secure auth system
// Password + fixed 6-digit PIN (not OTP), admin-managed users

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  loginId         String   @unique // email or username — admin sets this
  email           String   @unique
  fullName        String?
  passwordHash    String   // bcrypt hash of password
  pinHash         String   // bcrypt hash of 6-digit PIN (never plain)
  role            String   @default("user") // "admin" | "staff" | "user"
  status          String   @default("active") // "active" | "disabled"
  accessExpiresAt DateTime? // optional expiry date set by admin
  // PIN lockout tracking
  pinFailCount    Int      @default(0)
  pinLockedUntil  DateTime?
  // Login tracking
  lastLoginAt     DateTime?
  lastPinAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loginLogs       LoginLog[]
  pinLogs         PinLog[]
  auditLogs       AuditLog[]

  @@index([loginId])
  @@index([email])
  @@index([role])
  @@index([status])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  loginId   String   // the login ID attempted (even if user not found)
  event     String   // "login_success" | "login_fail" | "logout"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model PinLog {
  id        String   @id @default(cuid())
  userId    String?
  loginId   String
  event     String   // "pin_success" | "pin_fail" | "pin_locked" | "pin_reset" | "pin_unlocked"
  failCount Int?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // actor (admin who performed the action)
  action    String   // "user_create" | "user_delete" | "user_block" | "user_unblock" | "role_change" | "pin_reset" | "pin_unlock" | "expiry_set"
  targetId  String?  // user the action was performed on
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
