// Prisma schema for Pradip's Homoe — PIN-only auth system
// No passwords. Login is purely via unique 6-digit PIN.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String                         // required — display name
  email      String   @unique               // required — for user lookup at login
  pinHash    String                         // bcrypt hash of 6-digit PIN (slow, for verification)
  role       String   @default("user")      // "admin" | "staff" | "user"
  status     String   @default("active")    // "active" | "disabled"
  // PIN lockout tracking (5 wrong attempts → 15 min lock)
  pinFailCount   Int      @default(0)
  pinLockedUntil DateTime?
  // Login tracking
  lastLoginAt    DateTime?
  lastPinAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loginLogs LoginLog[]
  pinLogs   PinLog[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  name      String                         // name attempted (for log even if user not found)
  event     String                         // "login_success" | "login_fail" | "logout"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model PinLog {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  event     String   // "pin_success" | "pin_fail" | "pin_locked" | "pin_reset" | "pin_unlocked"
  failCount Int?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // actor (admin)
  action    String   // "user_create" | "user_delete" | "user_disable" | "user_enable" | "role_change" | "pin_reset" | "pin_unlock"
  targetId  String?  // user the action was performed on
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
